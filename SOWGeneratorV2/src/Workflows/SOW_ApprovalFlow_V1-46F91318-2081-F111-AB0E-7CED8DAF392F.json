                  "inputs": {
                    "parameters": {
                      "emailMessage/To": "@triggerBody()['text']",
                      "emailMessage/Subject": "Approval Request – Statement of Work (SOW)",
                      "emailMessage/Body": "<table cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f1f5f9;padding:36px 0;\">\n  <tbody><tr>\n    <td>\n      <table cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.09);\">\n\n        <!-- TOP BAR -->\n        <tbody><tr>\n          <td style=\"background:#0f2d6e;height:5px;font-size:0;\">&nbsp;</td>\n        </tr>\n\n        <!-- HEADER -->\n        <tr>\n          <td style=\"background:#0f2d6e;padding:30px 40px 28px 40px;\">\n            <table cellpadding=\"0\" cellspacing=\"0\">\n              <tbody><tr>\n                <td>\n                  <p style=\"margin:0 0 4px 0;font-size:11px;color:#93c5fd;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;\">Statement of Work</p>\n                  <h1 style=\"margin:0;font-size:22px;font-weight:700;color:#ffffff;\">Approval Request</h1>\n                </td>\n                <td>\n                  <span style=\"font-size:32px;\">📋</span>\n                </td>\n              </tr>\n            </tbody></table>\n          </td>\n        </tr>\n\n        <!-- GREETING -->\n        <tr>\n          <td style=\"padding:28px 40px 0 40px;\">\n            <p style=\"margin:0 0 8px 0;font-size:15px;color:#1e293b;\">Dear <strong>@{triggerBody()?['text_1']}</strong>,</p>\n            <p style=\"margin:0;font-size:14px;color:#64748b;line-height:1.7;\">I hope you're doing well. Kindly review the Statement of Work details below and share your approval to proceed.</p>\n          </td>\n        </tr>\n\n        <!-- ENGAGEMENT DETAILS SECTION -->\n        <tr>\n          <td style=\"padding:24px 40px 0 40px;\">\n            <p style=\"margin:0 0 12px 0;font-size:10px;font-weight:700;color:#0f2d6e;text-transform:uppercase;letter-spacing:2.5px;\">Engagement Details</p>\n            <table cellpadding=\"0\" cellspacing=\"0\" style=\"border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;\">\n\n              <tbody><tr style=\"background:#f8fafc;\">\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">SOW ID</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/Title']}</p>\n                </td>\n              </tr>\n\n              <tr>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Partner Name</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/Partner/Value']}</p>\n                </td>\n              </tr>\n\n              <tr style=\"background:#f8fafc;\">\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Client Name</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/ClientName']}</p>\n                </td>\n              </tr>\n\n              <tr>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Service Area</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/ServiceAreas/Value']}</p>\n                </td>\n              </tr>\n\n              <tr style=\"background:#f8fafc;\">\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Engagement Type</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/EngagementType/Value']}</p>\n                </td>\n              </tr>\n\n              <tr>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Environment</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/Environment/Value']}</p>\n                </td>\n              </tr>\n\n              <tr style=\"background:#f8fafc;\">\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Duration</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/TotalDuration']}</p>\n                </td>\n              </tr>\n\n              <tr>\n                <td style=\"padding:11px 16px;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Number of Phases</p>\n                </td>\n                <td style=\"padding:11px 16px;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/NumberOfPhases']}</p>\n                </td>\n              </tr>\n\n            </tbody></table>\n          </td>\n        </tr>\n\n        <!-- ENGAGEMENT BRIEF -->\n        <tr>\n          <td style=\"padding:16px 40px 0 40px;\">\n            <table cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eff6ff;border-left:3px solid #0f2d6e;border-radius:0 6px 6px 0;\">\n              <tbody><tr>\n                <td style=\"padding:14px 18px;\">\n                  <p style=\"margin:0 0 5px 0;font-size:10px;font-weight:700;color:#0f2d6e;text-transform:uppercase;letter-spacing:2px;\">Engagement Brief</p>\n                  <p style=\"margin:0;font-size:13px;color:#334155;line-height:1.7;\">@{outputs('Get_item')?['body/EngagementBrief']}</p>\n                </td>\n              </tr>\n            </tbody></table>\n          </td>\n        </tr>\n\n        <!-- PRICING SECTION -->\n        <tr>\n          <td style=\"padding:24px 40px 0 40px;\">\n            <p style=\"margin:0 0 12px 0;font-size:10px;font-weight:700;color:#059669;text-transform:uppercase;letter-spacing:2.5px;\">Pricing Summary</p>\n            <table cellpadding=\"0\" cellspacing=\"0\" style=\"border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;\">\n\n              <tbody><tr style=\"background:#f8fafc;\">\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Pricing Model</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/PricingModel/Value']}</p>\n                </td>\n              </tr>\n\n              <tr>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Phase Values</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/PhaseValues']}</p>\n                </td>\n              </tr>\n\n              <tr style=\"background:#f8fafc;\">\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:1px;\">Payment Terms</p>\n                </td>\n                <td style=\"padding:11px 16px;border-bottom:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:13px;color:#1e293b;font-weight:600;\">@{outputs('Get_item')?['body/PaymentTerms']}</p>\n                </td>\n              </tr>\n\n              <tr style=\"background:#f0fdf4;\">\n                <td style=\"padding:13px 16px;border-right:1px solid #e2e8f0;\">\n                  <p style=\"margin:0;font-size:11px;color:#059669;font-weight:700;text-transform:uppercase;letter-spacing:1px;\">Total Value</p>\n                </td>\n                <td style=\"padding:13px 16px;\">\n                  <p style=\"margin:0;font-size:15px;color:#047857;font-weight:800;\">@{outputs('Get_item')?['body/TotalValue']}</p>\n                </td>\n              </tr>\n\n            </tbody></table>\n          </td>\n        </tr>\n\n        <!-- POWER APPS BUTTON -->\n        <tr>\n          <td style=\"padding:28px 40px 0 40px;\">\n            <table cellpadding=\"0\" cellspacing=\"0\">\n              <tbody><tr>\n                <td style=\"background:#0f2d6e;border-radius:7px;\">\n                  <a href=\"@{outputs('Compose')}\" style=\"display:inline-block;padding:13px 32px;font-size:14px;font-weight:700;color:#ffffff;text-decoration:none;letter-spacing:0.3px;\">\n                    🚀 &nbsp; Open SOW in Power Apps\n                  </a>\n                </td>\n              </tr>\n            </tbody></table>\n          </td>\n        </tr>\n\n        <!-- CLOSING -->\n        <tr>\n          <td style=\"padding:26px 40px 0 40px;\">\n            <p style=\"margin:0 0 14px 0;font-size:14px;color:#64748b;line-height:1.7;\">Kindly <strong style=\"color:#1e293b;\">approve or share your feedback</strong> so we can move forward. Feel free to reach out if you need any clarification.</p>\n            <p style=\"margin:0;font-size:14px;color:#64748b;\">Thank you for your time.</p>\n            <p style=\"margin:14px 0 0 0;font-size:14px;color:#64748b;\">Regards,</p>\n            <p style=\"margin:3px 0 0 0;font-size:15px;font-weight:700;color:#0f2d6e;\">@{triggerBody()?['text_2']}</p>\n            <p style=\"margin:2px 0 0 0;font-size:12px;color:#94a3b8;\">[Designation] &nbsp;·&nbsp; [Email] &nbsp;·&nbsp; [Phone]</p>\n          </td>\n        </tr>\n\n        <!-- FOOTER -->\n        <tr>\n          <td style=\"padding:24px 40px 0 40px;\">\n            <hr style=\"border:none;border-top:1px solid #e2e8f0;margin:0;\">\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:14px 40px 24px 40px;\">\n            <p style=\"margin:0;font-size:11px;color:#cbd5e1;\">[Company Name] &nbsp;·&nbsp; Confidential &nbsp;·&nbsp; Automated Notification</p>\n          </td>\n        </tr>\n\n        <!-- BOTTOM BAR -->\n        <tr>\n          <td style=\"background:#0f2d6e;height:4px;font-size:0;\">&nbsp;</td>\n        </tr>\n\n      </tbody></table>\n    </td>\n  </tr>\n</tbody></table>",
